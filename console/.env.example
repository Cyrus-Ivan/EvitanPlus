APP_NAME="Evitan Provisioning Console"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The console is a CLI tool: no cache table, no queue worker, no sessions.
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# -----------------------------------------------------------------------------
# Supabase ADMIN connection (service role). DDL, role management, migrations.
#
# These credentials must NEVER appear in the POS app's .env at the repo root.
# Two independent defenses back that up (MULTIBRANCH-BRAINSTORM.md §18):
#   1. console/ is excluded from every build  -> nativephp.cleanup_exclude_files
#   2. CONSOLE_* is stripped from any shipped .env -> nativephp.cleanup_env_keys
# Both are gated by tests/Feature/Build/BuildExclusionTest.php.
#
# THIS connection uses Supabase's SESSION endpoint on port 5432 — either the
# direct connection (db.<project-ref>.supabase.co, IPv6-only unless you have the
# IPv4 add-on) or the session pooler (aws-<n>-<region>.pooler.supabase.com, IPv4).
# Do NOT point it at 6543 (transaction pooler): DDL, role management and
# search_path pinning all need session state that transaction mode discards.
#
# Branch devices are the opposite case and DO use 6543 — see CONSOLE_BRANCH_DB_*
# below. The two are not interchangeable.
#
# Pooler usernames are "postgres.<project-ref>", not plain "postgres".
# -----------------------------------------------------------------------------
CONSOLE_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
CONSOLE_DB_PORT=5432
CONSOLE_DB_DATABASE=postgres
CONSOLE_DB_USERNAME=postgres.your-project-ref
CONSOLE_DB_PASSWORD=
CONSOLE_DB_SSLMODE=require
CONSOLE_DB_SEARCH_PATH=public

# -----------------------------------------------------------------------------
# Provisioning (Phase M2)
# -----------------------------------------------------------------------------
# Recorded as the operator in the provisioning audit trail. Leave blank to use
# <os-user>@<hostname>, which is what distinguishes one developer's machine from
# another's. Set it explicitly on CI or a shared jump box.
CONSOLE_ACTOR=

# The Supabase tenant ref a BRANCH role logs in with through the pooler
# (Supavisor expects "<role>.<project-ref>"). Normally derived automatically from
# the suffix on CONSOLE_DB_USERNAME above; set it only when the console connects
# directly while branch devices go through the pooler, so there is no suffix to
# derive from.
CONSOLE_SUPABASE_PROJECT_REF=

# -----------------------------------------------------------------------------
# The endpoint branch devices connect through.
#
# This is what gets written into every branch credentials JSON, and the endpoint
# the console verifies each credential over before shipping it. Both default, so
# a normal Supabase setup leaves them blank: the admin's host, on port 6543.
#
# 6543 is Supabase's TRANSACTION pooler. It multiplexes Postgres backends across
# clients instead of pinning one per client for the connection's whole life, and
# that is the only shape that survives hundreds of branches — session mode's pool
# is 15 clients. Safe here because a branch role's schema is pinned server-side
# by ALTER ROLE ... SET search_path, which Postgres applies at backend startup.
#
# NOT the same thing as the POS app's BRANCH_DB_* keys: these say what the
# console EMITS, those say what an app INSTANCE connects with.
#
# Set the host explicitly in one case: the console connecting directly
# (db.<ref>.supabase.co) with CONSOLE_SUPABASE_PROJECT_REF set by hand. The port
# then defaults to 6543 but the inherited direct host does not serve it.
# -----------------------------------------------------------------------------
CONSOLE_BRANCH_DB_HOST=
CONSOLE_BRANCH_DB_PORT=
