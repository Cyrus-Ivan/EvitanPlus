.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/bootstrap/ssr
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
auth.json
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# SQLite database (never commit business data)
/database/*.sqlite
/database/*.sqlite-journal
/tests/e2e/.runtime
# The manual rig's runtime: throwaway SQLite databases AND the branch
# credentials JSONs it provisions, which hold plaintext Postgres passwords.
/tests/manual/.runtime
/test-results
/playwright-report
/storage/backups
/dist

# NativePHP build workspace (`build/app` is generated by native:build) — ignored
# except for build/php, the custom static PHP runtime the release ships. Git
# cannot re-include a file whose parent directory is excluded, so this must
# exclude `/build`'s *contents* rather than `/build` itself.
/build/*
!/build/php/
/build/php/dist

# Provisioning console (separate Laravel app — developer-only, never shipped).
# console/.env is already covered by the unanchored `.env` rule above, and
# console/{bootstrap/cache,storage} carry their own per-directory .gitignore.
/console/vendor

# Branch credentials JSON (Phase M2) — plaintext database passwords. Already
# ignored via console/storage/app/.gitignore, but that file is framework-owned
# and a future Laravel upgrade could rewrite it; committing a branch credential
# is not a mistake worth leaving to one `*` in a vendor-managed file.
/console/storage/app/credentials/
